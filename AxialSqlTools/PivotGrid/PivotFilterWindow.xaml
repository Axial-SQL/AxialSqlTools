<platform:DialogWindow x:Class="AxialSqlTools.PivotGrid.PivotFilterWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="Pivot Grid - Filter" Width="560" Height="570"
                       MinWidth="440" MinHeight="440" ResizeMode="CanResize"
                       ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                       Background="{DynamicResource AxialThemeBackgroundBrush}"
                       Foreground="{DynamicResource AxialThemeForegroundBrush}">
    <platform:DialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </platform:DialogWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="_Field" Target="{Binding ElementName=FieldPicker}" Padding="0,0,0,5" />
            <ComboBox x:Name="FieldPicker" Grid.Row="1" MinHeight="28" DisplayMemberPath="Label"
                      SelectionChanged="FieldChanged" AutomationProperties.Name="Filter field"
                      ToolTip="Choose the source field to filter." />
            <Label Grid.Column="2" Content="_Match" Target="{Binding ElementName=OperatorPicker}" Padding="0,0,0,5" />
            <ComboBox x:Name="OperatorPicker" Grid.Column="2" Grid.Row="1" MinHeight="28" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectionChanged="OperatorChanged"
                      AutomationProperties.Name="Filter operator" ToolTip="Choose how source values should match." />
        </Grid>
        <Grid Grid.Row="1">
            <Grid x:Name="ValuesPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,7">
                    <Label Content="_Search" Target="{Binding ElementName=ValueSearch}" Padding="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="ValueSearch" MinHeight="27" TextChanged="SearchChanged"
                             AutomationProperties.Name="Search distinct values"
                             ToolTip="Search the checklist. Values selected outside the search remain selected." />
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,7">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SelectVisibleButton" Content="Select all shown" Click="SelectVisibleClicked" Padding="8,3" Margin="0,0,6,0"
                                AutomationProperties.Name="Select all shown values" ToolTip="Select every value matching the search; keep other selections." />
                        <Button x:Name="ClearVisibleButton" Content="Clear shown" Click="ClearVisibleClicked" Padding="8,3"
                                AutomationProperties.Name="Clear shown values" ToolTip="Clear values matching the search; keep other selections." />
                    </StackPanel>
                    <TextBlock Text="Include values" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="ValueList" Grid.Row="2" MinHeight="120" HorizontalContentAlignment="Stretch"
                         SelectionMode="Single" PreviewKeyDown="ValueListKeyDown"
                         Background="{DynamicResource AxialThemeInputBackgroundBrush}"
                         Foreground="{DynamicResource AxialThemeInputForegroundBrush}"
                         BorderBrush="{DynamicResource AxialThemeBorderBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Distinct source values" ToolTip="Use the arrow keys and Space to select values.">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Display}"
                                      ToolTip="{Binding Display}" Focusable="True">
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SelectionInfo" Grid.Row="3" Margin="0,7,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                <Label x:Name="TextValueLabel" Content="_Value" Target="{Binding ElementName=TextValue}" Padding="0,0,0,5" />
                <TextBox x:Name="TextValue" MinHeight="28" AutomationProperties.Name="Filter comparison value"
                         ToolTip="Enter the value to compare with the source field." TextChanged="TextValueChanged" />
                <TextBlock x:Name="TextHint" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <TextBlock x:Name="NullHint" Visibility="Collapsed" TextWrapping="Wrap" />
        </Grid>
        <TextBlock x:Name="ValidationMessage" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource AxialThemeStatusErrorBrush}" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="12,5" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Content="Apply filter" IsDefault="True" Click="ApplyClicked" MinWidth="100" Padding="12,5" />
        </StackPanel>
    </Grid>
</platform:DialogWindow>
