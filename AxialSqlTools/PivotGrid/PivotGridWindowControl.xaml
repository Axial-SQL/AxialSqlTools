<UserControl x:Class="AxialSqlTools.PivotGrid.PivotGridWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700" MinHeight="420"
             Background="{DynamicResource AxialThemeBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SourceInfo" Text="Capturing result grid..." Margin="0,0,0,8" TextWrapping="Wrap" />
        <Grid x:Name="Options" Grid.Row="1" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Rows" Margin="0,0,8,0">
                <ListBox x:Name="RowFields" Height="116" SelectionMode="Multiple" DisplayMemberPath="Label"
                         ToolTip="Click to select or deselect fields. Groups follow source column order." />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Columns" Margin="0,0,8,0">
                <ListBox x:Name="ColumnFields" Height="116" SelectionMode="Multiple" DisplayMemberPath="Label"
                         ToolTip="Leave empty for a grouped summary. Click to select or deselect fields." />
            </GroupBox>
            <StackPanel Grid.Column="2">
                <Label Content="_Aggregation" Target="{Binding ElementName=AggregationBox}" />
                <ComboBox x:Name="AggregationBox" SelectionChanged="AggregationChanged" DisplayMemberPath="Label" />
                <Label Content="_Values" Target="{Binding ElementName=ValueField}" />
                <ComboBox x:Name="ValueField" DisplayMemberPath="Label" />
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox x:Name="NullTextIsNull" Content="Treat displayed NULL as null" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="SSMS exposes display text. SQL NULL and the literal text NULL cannot be distinguished in text columns. Clear this option to count them as text. Numeric NULLs are always null." />
                    <Label Content="Sort values" Target="{Binding ElementName=ValueSort}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ValueSort" Width="110" SelectedIndex="0" SelectionChanged="ValueSortChanged"
                              ToolTip="Sort rows by Value, or by the row Grand total when Columns are selected. Grand total stays last. None restores the original order.">
                        <ComboBoxItem Content="None" />
                        <ComboBoxItem Content="Ascending" />
                        <ComboBoxItem Content="Descending" />
                    </ComboBox>
                </WrapPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Content="_Filter" Target="{Binding ElementName=FilterField}" VerticalAlignment="Center" />
            <ComboBox x:Name="FilterField" Grid.Column="1" DisplayMemberPath="Label" IsEnabled="False" />
            <Label Grid.Column="2" Content="contains" VerticalAlignment="Center" />
            <TextBox x:Name="FilterText" Grid.Column="3" Margin="4,0,12,0" VerticalContentAlignment="Center"
                     IsEnabled="False" ToolTip="Case-insensitive search in the displayed source values." />
            <Button x:Name="ApplyButton" Grid.Column="4" Content="_Apply" Click="ApplyClicked" IsEnabled="False" Padding="14,5" Margin="0,0,6,0" />
            <Button x:Name="CancelButton" Grid.Column="5" Content="Cancel" Click="CancelClicked" IsEnabled="False" Padding="14,5" />
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        <DataGrid x:Name="ResultGrid" Grid.Row="0"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.ScrollChanged="ResultScrollChanged" ColumnReordered="ResultColumnReordered"
                  MouseDoubleClick="ResultDoubleClicked" PreviewMouseRightButtonDown="ResultRightClicked"
                  PreviewKeyDown="ResultKeyDown" CurrentCellChanged="ResultCurrentCellChanged"
                  ContextMenuOpening="ResultContextMenuOpening" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="White" RowBackground="White" AlternatingRowBackground="White" Foreground="Black"
                  HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="DrillMenuItem" Header="Show underlying rows" Click="DrillClicked" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Background" Value="WhiteSmoke" />
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="BorderBrush" Value="LightGray" />
                    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Match the results grid's reserved vertical scrollbar gutter. -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Width="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                <DataGrid x:Name="TotalGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="None" ClipboardCopyMode="IncludeHeader"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                          Background="WhiteSmoke" RowBackground="WhiteSmoke" Foreground="Black"
                          HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray"
                          EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.ScrollChanged="ResultScrollChanged"
                          SelectionUnit="CellOrRowHeader"
                          MouseDoubleClick="ResultDoubleClicked" PreviewMouseRightButtonDown="ResultRightClicked"
                          PreviewKeyDown="ResultKeyDown" CurrentCellChanged="ResultCurrentCellChanged"
                          ContextMenuOpening="ResultContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="TotalDrillMenuItem" Header="Show underlying rows" Click="DrillClicked" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <DockPanel>
                <Button x:Name="DrillButton" DockPanel.Dock="Right" Content="Show underlying rows" IsEnabled="False"
                        Click="DrillClicked" Padding="10,4" Margin="8,0,0,0" ToolTip="Select a value or total, then click here, double-click the cell, or press Enter." />
                <TextBlock x:Name="Status" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="Snapshot of displayed grid values. SSMS text truncation applies. Calculated with NReco.PivotData."
                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
