<UserControl x:Class="AxialSqlTools.PivotGrid.PivotGridWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AxialSqlTools.PivotGrid"
             MinWidth="700" MinHeight="420" PreviewKeyDown="ControlKeyDown" SizeChanged="ControlSizeChanged"
             Background="{DynamicResource AxialThemeBackgroundBrush}"
             Foreground="{DynamicResource AxialThemeForegroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SourceInfo" Text="Capturing result grid..." Margin="0,0,0,6" TextWrapping="Wrap" />
        <WrapPanel x:Name="LayoutToolbar" Grid.Row="1" Margin="0,0,0,6" IsEnabled="False">
            <Label Content="_Layout" Target="{Binding ElementName=LayoutNames}" VerticalAlignment="Center" />
            <ComboBox x:Name="LayoutNames" Width="180" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                      VerticalAlignment="Center" ToolTip="Choose a saved layout or enter a name to save. Layouts match the result column names, order and types." />
            <Button Content="Load" Click="LoadLayoutClicked" Padding="9,3" Margin="5,0,0,0" ToolTip="Load this layout into setup, then Apply." />
            <Button Content="Save" Click="SaveLayoutClicked" Padding="9,3" Margin="5,0,0,0" ToolTip="Save the current setup using this name." />
            <Button Content="Delete" Click="DeleteLayoutClicked" Padding="9,3" Margin="5,0,12,0" ToolTip="Delete the selected named layout." />
            <Button Content="Swap rows/columns" Click="SwapAxesClicked" Padding="9,3" Margin="0,0,5,0" />
            <Button Content="Reset" Click="ResetClicked" Padding="9,3" ToolTip="Reset setup to Count rows with no groups or filters. Apply to update the grid." />
        </WrapPanel>
        <Expander x:Name="SetupExpander" Grid.Row="2" Header="Fields and filters" IsExpanded="True" Margin="0,0,0,6">
            <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="310">
                <local:PivotBuilderControl x:Name="Builder" Margin="0,6,0,0" IsEnabled="False" />
            </ScrollViewer>
        </Expander>
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="AppliedSummary" Text="Choose fields or apply an ungrouped count." TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="PendingState" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ApplyButton" Content="_Apply" Click="ApplyClicked" IsEnabled="False" Padding="14,4" Margin="0,0,5,0"
                        ToolTip="Apply setup to the captured rows. Ctrl+Enter also applies changes." />
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelClicked" IsEnabled="False" Padding="10,4" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4" MinHeight="100">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        <DataGrid x:Name="ResultGrid" Grid.Row="0"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.ScrollChanged="ResultScrollChanged" ColumnReordered="ResultColumnReordered"
                  MouseDoubleClick="ResultDoubleClicked" PreviewMouseRightButtonDown="ResultRightClicked"
                  PreviewKeyDown="ResultKeyDown" CurrentCellChanged="ResultCurrentCellChanged"
                  ContextMenuOpening="ResultContextMenuOpening" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource AxialThemeBackgroundBrush}" RowBackground="{DynamicResource AxialThemeBackgroundBrush}" AlternatingRowBackground="{DynamicResource AxialThemeBackgroundBrush}" Foreground="{DynamicResource AxialThemeForegroundBrush}"
                  HorizontalGridLinesBrush="{DynamicResource AxialThemeBorderBrush}" VerticalGridLinesBrush="{DynamicResource AxialThemeBorderBrush}"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" Sorting="ResultSorting"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="DrillMenuItem" Header="Show underlying rows" Click="DrillClicked" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Background" Value="{DynamicResource AxialThemeGridHeaderBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AxialThemeBorderBrush}" />
                    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Match the results grid's reserved vertical scrollbar gutter. -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Width="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                <DataGrid x:Name="TotalGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="None" ClipboardCopyMode="IncludeHeader"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                          Background="{DynamicResource AxialThemeGridHeaderBackgroundBrush}" RowBackground="{DynamicResource AxialThemeGridHeaderBackgroundBrush}" Foreground="{DynamicResource AxialThemeForegroundBrush}"
                          HorizontalGridLinesBrush="{DynamicResource AxialThemeBorderBrush}" VerticalGridLinesBrush="{DynamicResource AxialThemeBorderBrush}"
                          EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.ScrollChanged="ResultScrollChanged"
                          SelectionUnit="CellOrRowHeader"
                          MouseDoubleClick="ResultDoubleClicked" PreviewMouseRightButtonDown="ResultRightClicked"
                          PreviewKeyDown="ResultKeyDown" CurrentCellChanged="ResultCurrentCellChanged"
                          ContextMenuOpening="ResultContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="TotalDrillMenuItem" Header="Show underlying rows" Click="DrillClicked" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="5" Margin="0,6,0,0">
            <DockPanel>
                <Button x:Name="DrillButton" DockPanel.Dock="Right" Content="Show underlying rows" IsEnabled="False"
                        Click="DrillClicked" Padding="10,4" Margin="8,0,0,0" ToolTip="Select a value or total, then click here, double-click the cell, or press Enter." />
                <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Snapshot of displayed values. SSMS text truncation applies. Click a header to sort; click again to reverse, then clear. Ctrl+C copies selected cells."
                       Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
