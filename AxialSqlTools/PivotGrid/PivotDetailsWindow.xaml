<platform:DialogWindow x:Class="AxialSqlTools.PivotGrid.PivotDetailsWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="Pivot Grid - Underlying rows" Width="1200" Height="760"
                       MinWidth="720" MinHeight="420" ResizeMode="CanResize"
                       ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                       Background="{DynamicResource AxialThemeBackgroundBrush}"
             Foreground="{DynamicResource AxialThemeForegroundBrush}">
    <platform:DialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </platform:DialogWindow.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Underlying rows" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailsTitle" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxHeight="60" Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock Text="All source rows in the selected group, including duplicates and null values. The pivot's applied filter is preserved."
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="DetailsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource AxialThemeBackgroundBrush}" RowBackground="{DynamicResource AxialThemeBackgroundBrush}" AlternatingRowBackground="{DynamicResource AxialThemeBackgroundBrush}" Foreground="{DynamicResource AxialThemeForegroundBrush}"
                  HorizontalGridLinesBrush="{DynamicResource AxialThemeBorderBrush}" VerticalGridLinesBrush="{DynamicResource AxialThemeBorderBrush}"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True" SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Background" Value="{DynamicResource AxialThemeGridHeaderBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AxialThemeBorderBrush}" />
                    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PreviousPageButton" Content="Previous" Click="PreviousPageClicked" Padding="12,5" Margin="0,0,6,0" />
                <Button x:Name="NextPageButton" Content="Next" Click="NextPageClicked" Padding="12,5" Margin="0,0,18,0" />
                <Button Content="Close" IsCancel="True" Padding="16,5" />
            </StackPanel>
            <TextBlock x:Name="DetailsPageInfo" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</platform:DialogWindow>
