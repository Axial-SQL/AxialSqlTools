<Window x:Class="AxialSqlTools.JobQuickView.JobQuickViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Quick Manage" Width="1200" Height="820" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AxialThemeBackgroundBrush}"
        Foreground="{DynamicResource AxialThemeForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="EnableIconGeometry">M 1,7 L 5,11 L 13,2 L 15,4 L 5,15 L 0,9 Z</Geometry>
            <Geometry x:Key="DisableIconGeometry">M 2,0 L 8,6 L 14,0 L 16,2 L 10,8 L 16,14 L 14,16 L 8,10 L 2,16 L 0,14 L 6,8 L 0,2 Z</Geometry>
            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource AxialThemeSubtleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource AxialThemeHeaderBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="11,6" />
            </Style>
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="ActionIcon" TargetType="Path">
                <Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" />
                <Setter Property="Stretch" Value="Uniform" /><Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Style>
            <Style x:Key="DetailTable" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserReorderColumns" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="RowHeaderWidth" Value="0" />
            </Style>
            <Style x:Key="DetailValue" TargetType="TextBlock">
                <Setter Property="Margin" Value="9,7" /><Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="260" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="SQL SERVER AGENT / QUICK MANAGE" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AxialThemeLinkBrush}" Margin="0,0,0,5" />
                <TextBlock x:Name="JobNameText" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="ServerText" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="EnabledBadge" Style="{StaticResource StatusBadge}" Margin="0,0,7,0">
                    <TextBlock x:Name="EnabledText" Text="Loading" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="RunningBadge" Style="{StaticResource StatusBadge}">
                    <TextBlock x:Name="RunningText" Text="Checking status" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Style="{StaticResource ActionButton}" Click="Start_Click" IsEnabled="False"
                        ToolTip="Run the saved job from its configured starting step" AutomationProperties.Name="Start job">
                    <StackPanel Orientation="Horizontal"><Path Data="M 0,0 L 12,7 L 0,14 Z" Style="{StaticResource ActionIcon}" /><TextBlock Text="Start job" /></StackPanel>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource ActionButton}" Click="Stop_Click" IsEnabled="False" AutomationProperties.Name="Stop job">
                    <StackPanel Orientation="Horizontal"><Path Data="M 0,0 H 12 V 12 H 0 Z" Style="{StaticResource ActionIcon}" /><TextBlock Text="Stop job" /></StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource AxialThemeSubtleBorderBrush}" Margin="3,3,11,3" />
                <Button x:Name="EnabledButton" Style="{StaticResource ActionButton}" Click="Enabled_Click" IsEnabled="False" AutomationProperties.Name="Enable or disable job">
                    <StackPanel Orientation="Horizontal"><Path x:Name="EnabledIcon" Data="{StaticResource DisableIconGeometry}" Style="{StaticResource ActionIcon}" /><TextBlock x:Name="EnabledActionText" Text="Disable job" /></StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Style="{StaticResource ActionButton}" Click="Refresh_Click" ToolTip="Refresh job information (F5). Unsaved step edits are preserved." AutomationProperties.Name="Refresh job">
                    <StackPanel Orientation="Horizontal"><Path Data="M 12,5 A 5,5 0 1 0 11,10 M 8,5 L 12,5 L 12,1" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Style="{StaticResource ActionIcon}" /><TextBlock Text="Refresh" /></StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="RefreshText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Loading job information..." FontSize="12" />
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource AxialThemeHeaderBackgroundBrush}" BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LAST EXECUTION" FontSize="10" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LastRunSummaryText" Text="Loading..." FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="LastRunDetailText" Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AxialThemeSubtleBorderBrush}" />
                <StackPanel Grid.Column="2" Margin="13,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NEXT EXECUTION" FontSize="10" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NextRunText" Text="Loading..." FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="NextRunDetailText" Text="SQL Server local time" Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="MessageBanner" Grid.Row="3" Visibility="Collapsed" BorderThickness="3,0,0,0"
                BorderBrush="{DynamicResource AxialThemeAccentBrush}" Background="{DynamicResource AxialThemeHeaderBackgroundBrush}"
                Padding="10,8" Margin="0,0,0,10" MaxHeight="96">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </ScrollViewer>
        </Border>
        <TabControl x:Name="MainTabs" Grid.Row="4">
            <TabItem x:Name="StepsTab" Header="Steps">
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245" MinWidth="190" /><ColumnDefinition Width="9" /><ColumnDefinition MinWidth="420" /></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" BorderThickness="0,0,0,1"
                            Background="{DynamicResource AxialThemeHeaderBackgroundBrush}" Padding="12,10">
                        <TextBlock x:Name="StepsCountText" Text="JOB STEPS" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <ListBox x:Name="StepsList" Grid.Row="1" BorderThickness="0" SelectionChanged="Steps_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Job steps">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="11,10" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="9,8">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Details}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <Border Background="{DynamicResource QuickManageDirtyBackgroundBrush}" CornerRadius="3" Padding="5,3" Margin="0,5,0,0" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers><DataTrigger Binding="{Binding EditState}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding EditState}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource QuickManageDirtyForegroundBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Drafts stay with each step." FontSize="11" Margin="11,8" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ToolTip="Resize the step list" />
            <Border Grid.Column="2" BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource AxialThemeHeaderBackgroundBrush}" Padding="13,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="StepNameText" Text="Select a job step" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="StepContextText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="FindButton" Content="Find" Margin="0,0,7,0" Padding="10,5" Click="Find_Click" IsEnabled="False" ToolTip="Find in this command (Ctrl+F)" />
                                <Button x:Name="FormatButton" Content="Format SQL" Padding="10,5" Click="Format_Click" IsEnabled="False"
                                        ToolTip="Format the selection or entire SQL command (Ctrl+Shift+F). Changes remain a draft until saved." />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" Padding="13,6">
                        <TextBlock x:Name="StepFlowText" FontSize="11" TextWrapping="Wrap" Text="Step commands load asynchronously." />
                    </Border>
                    <avalonedit:TextEditor x:Name="CommandEditor" Grid.Row="2" Style="{StaticResource AxialSqlEditorStyle}"
                                          BorderThickness="0" FontSize="14" Padding="6,8" IsReadOnly="True"
                                          PreviewMouseWheel="Editor_PreviewMouseWheel" AutomationProperties.Name="Job step command" />
                    <TextBlock x:Name="EditorEmptyText" Grid.Row="2" Text="Loading job steps..." TextWrapping="Wrap" Margin="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="EditorFooter" Grid.Row="3" BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="EditorStateText" Text="{Binding EditorStatus}" FontSize="12" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource QuickManageDirtyTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="CaretText" Text="Ctrl+F Find  |  Ctrl+S Save  |  Ctrl+wheel Zoom" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="EditorActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DiscardButton" Content="Discard" Margin="0,0,7,0" Padding="12,6" Click="Discard_Click" IsEnabled="{Binding IsDirty, FallbackValue=False}" />
                                <Button x:Name="SaveButton" Content="Save step" Style="{StaticResource AxialPrimaryButtonStyle}" Padding="13,6" Click="Save_Click" IsEnabled="{Binding CanSave, FallbackValue=False}"
                                        ToolTip="Save only the command of the selected step (Ctrl+S)" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
            </TabItem>
            <TabItem Header="Job details">
                <DataGrid x:Name="JobDetailsGrid" Style="{StaticResource DetailTable}" Margin="0,8,0,0" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Job details">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Property" Binding="{Binding Field}" Width="180" ElementStyle="{StaticResource DetailValue}" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource DetailValue}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Schedules">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="ScheduleStatusText" Text="Loading schedules..." Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid x:Name="SchedulesGrid" Grid.Row="1" Style="{StaticResource DetailTable}" AutomationProperties.Name="Job schedules">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Schedule" Binding="{Binding Name}" Width="210" ElementStyle="{StaticResource DetailValue}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource DetailValue}" />
                            <DataGridTextColumn Header="Frequency" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource DetailValue}" />
                            <DataGridTextColumn Header="Next execution" Binding="{Binding NextRun}" Width="165" ElementStyle="{StaticResource DetailValue}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ScheduleNoteText" Grid.Row="2" Margin="0,9,0,0" FontSize="11" TextWrapping="Wrap" />
                </Grid>
            </TabItem>
            <TabItem Header="Execution">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="3*" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
                    <DataGrid x:Name="ExecutionGrid" Style="{StaticResource DetailTable}" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Execution details">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Property" Binding="{Binding Field}" Width="180" ElementStyle="{StaticResource DetailValue}" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource DetailValue}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Last execution message" Margin="0,12,0,6" FontWeight="SemiBold" />
                    <TextBox x:Name="LastRunMessageText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" Padding="10"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Last execution message" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
