<platform:DialogWindow x:Class="AxialSqlTools.FormatOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="Query Format Options" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AxialThemeBackgroundBrush}"
        Foreground="{DynamicResource AxialThemeForegroundBrush}">
    <platform:DialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </platform:DialogWindow.Resources>
    <DockPanel Margin="12" MinWidth="520">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Select formatting options"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CheckAllButton"
                        Content="Check all"
                        Padding="12,4"
                        Click="CheckAllOptions_Click"/>
                <Button x:Name="UncheckAllButton"
                        Content="Uncheck all"
                        Padding="12,4"
                        Click="UncheckAllOptions_Click"/>
            </StackPanel>
        </Grid>
        <CheckBox x:Name="DisregardSsmsFormatterSettings" DockPanel.Dock="Top" Margin="10,0,10,8"
                              Content="Disregard SSMS Formatter settings"
                              ToolTip="Use fresh instances of the parser and generator types selected by SSMS, then use the original Axial code generation, alignment, and comment handling. Axial formatting options still apply afterward."
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
        <UniformGrid Columns="2" Margin="5" HorizontalAlignment="Left">
            <CheckBox x:Name="PreserveComments" Margin="5"
                 Content="Preserve comments"
                      ToolTip="Always preserve comments. When unchecked, Format follows the selected formatter mode&apos;s comment setting."
                 Checked="formatSetting_Checked"
                 Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="RemoveNewLineAfterJoin" Margin="5"
                Content="Remove new line after JOIN"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="AddTabAfterJoinOn" Margin="5"
                Content="Add tab after JOIN..ON"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="MoveCrossJoinToNewLine" Margin="5"
                Content="Place CROSS/OUTER JOIN/APPLY on a new line"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="FormatCaseAsMultiline" Margin="5"
                Content="Format CASE expression as multiline"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="AddNewLineBetweenStatementsInBlocks" Margin="5"
                Content="Add new line between statements in code blocks"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="BreakSprocParametersPerLine" Margin="5"
                Content="Break exec sproc parameters per line"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="UppercaseBuiltInFunctions" Margin="5"
                Content="Always upper-case built-in functions"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="UnindentBeginEndBlocks" Margin="5"
                Content="Unindent Begin..End blocks"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="BreakVariableDefinitionsPerLine" Margin="5"
                Content="Break variable definitions per line"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="BreakSprocDefinitionParametersPerLine" Margin="5"
                Content="Break sproc definition parameters per line"
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
            <CheckBox x:Name="BreakSelectFieldsAfterTopAndUnindent" Margin="5"
                Content="Use standard field indentation after DISTINCT/TOP"
                ToolTip="Move every SELECT field to a new line with one normal indentation level, independent of DISTINCT or TOP. Applies to nested queries and CTEs."
                Checked="formatSetting_Checked"
                Unchecked="formatSetting_Unchecked"/>
        </UniformGrid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" IsDefault="True" Content="OK" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Width="90" IsCancel="True" Content="Cancel"/>
        </StackPanel>
    </DockPanel>
</platform:DialogWindow>
