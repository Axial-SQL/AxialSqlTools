<UserControl x:Class="AxialSqlTools.SqlServerBuildsWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:axialsqltools="clr-namespace:AxialSqlTools"
             Background="{DynamicResource AxialThemeBackgroundBrush}"
             Foreground="{DynamicResource AxialThemeForegroundBrush}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="SQLServerBuilds">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AxialThemeBackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="SQL Server Builds" FontSize="18" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0"/>
            <Button x:Name="OpenWorkbookButton" Content="Open .xlsx..." Click="OpenWorkbook_Click" Margin="0,0,16,0"/>
            <TextBlock VerticalAlignment="Center">
                <Hyperlink Click="HyperlinkDataSource_Click"><Run Text="Microsoft source"/></Hyperlink>
                <Run Text=" | "/>
                <Hyperlink x:Name="CopySqlLink" Click="HyperlinkCopyAsTSQL_Click"><Run Text="Copy as TSQL"/></Hyperlink>
            </TextBlock>
        </WrapPanel>
        <Border Grid.Row="1" Background="{DynamicResource AxialThemeHeaderBackgroundBrush}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <ProgressBar x:Name="LoadingProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Expander x:Name="Diagnostics" Grid.Row="2" Header="Load and parsing details" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBox x:Name="DiagnosticText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
        </Expander>
        <TextBlock Panel.ZIndex="1" x:Name="EmptyText" Grid.Row="3" Text="No builds to display. Retry the download or open a readable .xlsx workbook." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TreeView x:Name="sqlVersionTreeView" Grid.Row="3" Margin="0"
                  Background="{DynamicResource AxialThemeBackgroundBrush}"
                  Foreground="{DynamicResource AxialThemeForegroundBrush}"
                  BorderBrush="{DynamicResource AxialThemeBorderBrush}">
            <TreeView.Resources>
                <!-- Style for Grid-like Row -->
                <Style TargetType="TreeViewItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="{DynamicResource AxialThemeBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}"/>
                </Style>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
