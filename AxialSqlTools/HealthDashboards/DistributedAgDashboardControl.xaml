<UserControl x:Class="AxialSqlTools.DistributedAgDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1260" d:DesignHeight="700"
             Background="{DynamicResource AxialThemeBackgroundBrush}"
             Foreground="{DynamicResource AxialThemeForegroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HealthText" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Healthy">
                        <Setter Property="Foreground" Value="{DynamicResource AxialThemeStatusSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Critical">
                        <Setter Property="Foreground" Value="{DynamicResource AxialThemeStatusErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Warning">
                        <Setter Property="Foreground" Value="{DynamicResource AxialThemeLinkBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="HealthGlyph" TargetType="TextBlock" BasedOn="{StaticResource HealthText}">
                <Setter Property="Text" Value="?" />
                <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Healthy"><Setter Property="Text" Value="✓" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Critical"><Setter Property="Text" Value="✕" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Warning"><Setter Property="Text" Value="!" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="DatabaseHealthCell">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.ToolTip>
                        <StackPanel MaxWidth="420">
                            <TextBlock Text="{Binding SynchronizationHealth}" />
                            <TextBlock Text="{Binding LocalIssue}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel.ToolTip>
                    <TextBlock Style="{StaticResource HealthGlyph}" />
                    <TextBlock Text="{Binding DisplayHealth}" Style="{StaticResource HealthText}" />
                </StackPanel>
            </DataTemplate>
            <Style x:Key="NumberCell" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style x:Key="HealthGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
                <Setter Property="HeadersVisibility" Value="Column" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="AG Health Dashboard" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="ConnectionLabel" Text="Select an availability group in Object Explorer to begin."
                       Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="Availability group" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="GroupPicker" MinWidth="230" MaxWidth="440" Margin="0,0,12,0"
                      SelectionChanged="GroupChanged" ToolTip="Regular and distributed availability groups on this instance" />
            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" Padding="16,5" Margin="0,0,12,0" IsEnabled="False" />
            <CheckBox x:Name="AutoRefreshBox" Content="Auto-refresh every 30 seconds" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="UpdatedLabel" Text="Not refreshed yet" VerticalAlignment="Center" />
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border x:Name="LocalSummary" Padding="12" Margin="0,0,10,0" CornerRadius="3" BorderThickness="1"
                    BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}"
                    Background="{DynamicResource AxialThemeHeaderBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="DATABASE HEALTH ON THIS NODE" FontSize="11" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,4">
                        <TextBlock Style="{StaticResource HealthGlyph}" FontSize="19" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource HealthText}" FontSize="19" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" ToolTip="{Binding StatusDetail}" />
                    <TextBlock x:Name="LocalRoleLabel" Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="GroupSummary" Grid.Column="1" Padding="12" CornerRadius="3" BorderThickness="1"
                    BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="GroupScopeLabel" Text="AG VISIBILITY" FontSize="11" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,4">
                        <TextBlock Style="{StaticResource HealthGlyph}" FontSize="17" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource HealthText}" FontSize="17" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" MaxHeight="64" ToolTip="{Binding StatusDetail}" />
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <ProgressBar x:Name="BusyIndicator" Height="3" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="SnapshotNoteLabel" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorLabel" Visibility="Collapsed" Foreground="{DynamicResource AxialThemeStatusErrorBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <TabControl Grid.Row="4">
            <TabItem Header="Databases on this node">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="LocalCountLabel" Text="Local databases for the selected availability group."
                               Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid x:Name="LocalDatabaseGrid" Grid.Row="1" Style="{StaticResource HealthGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="160" />
                            <DataGridTextColumn Header="AG" Binding="{Binding GroupName}" Width="150" />
                            <DataGridTextColumn Header="Local role" Binding="{Binding Role}" Width="95" />
                            <DataGridTemplateColumn Header="Health" CellTemplate="{StaticResource DatabaseHealthCell}" SortMemberPath="DisplayHealth" Width="145" />
                            <DataGridTextColumn Header="Synchronization" Binding="{Binding SynchronizationState}" Width="150" />
                            <DataGridTextColumn Header="Database state" Binding="{Binding DatabaseState}" Width="125" />
                            <DataGridTextColumn Header="Lag (seconds)" Binding="{Binding LagSeconds, StringFormat=N0, TargetNullValue=N/A}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Redo queue (KB)" Binding="{Binding RedoQueueKb, StringFormat=N0, TargetNullValue=N/A}" Width="125" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Send queue (KB)" Binding="{Binding SendQueueKb, StringFormat=N0, TargetNullValue=N/A}" Width="125" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Last redone (server time)" Binding="{Binding LastRedoneTime, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=N/A}" Width="190" />
                            <DataGridTextColumn Header="Last hardened (server time)" Binding="{Binding LastHardenedTime, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=N/A}" Width="190" />
                            <DataGridTextColumn Header="Suspension reason" Binding="{Binding SuspendReason}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="LocalEmptyLabel" Grid.Row="1" Text="No snapshot loaded." HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="540" Margin="20" IsHitTestVisible="False" />
                </Grid>
            </TabItem>
            <TabItem Header="Replica details">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="ReplicaCountLabel" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Local and remote database rows reported by the connected instance." />
                    <DataGrid x:Name="ReplicaGrid" Grid.Row="1" Style="{StaticResource HealthGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="150" />
                            <DataGridTemplateColumn Header="Health" CellTemplate="{StaticResource DatabaseHealthCell}" SortMemberPath="DisplayHealth" Width="145" />
                            <DataGridTextColumn Header="Synchronization" Binding="{Binding SynchronizationState}" Width="150" />
                            <DataGridTextColumn Header="AG" Binding="{Binding GroupName}" Width="150" />
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeLabel}" Width="140" />
                            <DataGridTextColumn Header="Replica / member AG" Binding="{Binding MemberName}" Width="200" />
                            <DataGridTextColumn Header="Location" Binding="{Binding LocationLabel}" Width="110" />
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="110" />
                            <DataGridTextColumn Header="Lag (seconds)" Binding="{Binding LagSeconds, StringFormat=N0, TargetNullValue=N/A}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Send queue (KB)" Binding="{Binding SendQueueKb, StringFormat=N0, TargetNullValue=N/A}" Width="125" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Send (KB/s)" Binding="{Binding SendRateKb, StringFormat=N0, TargetNullValue=N/A}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Redo queue (KB)" Binding="{Binding RedoQueueKb, StringFormat=N0, TargetNullValue=N/A}" Width="125" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Redo (KB/s)" Binding="{Binding RedoRateKb, StringFormat=N0, TargetNullValue=N/A}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Database state" Binding="{Binding DatabaseState}" Width="125" />
                            <DataGridTextColumn Header="Suspended" Binding="{Binding IsSuspended, TargetNullValue=N/A}" Width="90" />
                            <DataGridTextColumn Header="Last redone (server time)" Binding="{Binding LastRedoneTime, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=N/A}" Width="190" />
                            <DataGridTextColumn Header="Last commit (server time)" Binding="{Binding LastCommitTime, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=N/A}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ReplicaEmptyLabel" Grid.Row="1" Text="No replica rows reported." HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="540" Margin="20" IsHitTestVisible="False" />
                </Grid>
            </TabItem>
            <TabItem Header="Availability replicas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MemberCards" Margin="8">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="340" Margin="0,0,10,10" Padding="12" BorderThickness="1" CornerRadius="3"
                                        BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding GroupName}" FontSize="11" />
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,3" />
                                        <TextBlock Text="{Binding ScopeLabel}" />
                                        <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Margin="0,5,0,3" />
                                        <TextBlock Text="{Binding LocationLabel}" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding SynchronizationHealth}">
                                            <TextBlock Style="{StaticResource HealthGlyph}" />
                                            <TextBlock Text="{Binding DisplayHealth}" Style="{StaticResource HealthText}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ConnectionState, StringFormat='Connection: {0}'}" ToolTip="{Binding LastError}" Margin="0,5,0,3" />
                                        <TextBlock Text="{Binding AvailabilityMode}" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding EndpointUrl}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EndpointUrl}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                   Text="Lag is SQL Server's reported secondary lag, not time since the last transaction. N/A means unavailable. Remote values can be last reported. A healthy local database does not establish distributed-link health or failover readiness." />
    </Grid>
</UserControl>
