<UserControl x:Class="AxialSqlTools.DistributedAgDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="690"
             Background="{DynamicResource AxialThemeBackgroundBrush}"
             Foreground="{DynamicResource AxialThemeForegroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HealthText" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Healthy">
                        <Setter Property="Foreground" Value="{DynamicResource AxialThemeStatusSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Critical">
                        <Setter Property="Foreground" Value="{DynamicResource AxialThemeStatusErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="Warning">
                        <Setter Property="Foreground" Value="{DynamicResource AxialThemeLinkBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NumberCell" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="130" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Distributed AG Health Dashboard" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ConnectionLabel" Text="Select an availability group in Object Explorer to begin."
                       Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="Distributed AG" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="GroupPicker" MinWidth="230" MaxWidth="440" Margin="0,0,12,0"
                      SelectionChanged="GroupChanged" ToolTip="Distributed availability groups on the connected instance" />
            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" Padding="16,5" Margin="0,0,12,0"
                    Style="{DynamicResource AxialPrimaryButtonStyle}" IsEnabled="False" />
            <CheckBox x:Name="AutoRefreshBox" Content="Auto-refresh every 30 seconds" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="UpdatedLabel" Text="Not refreshed yet" VerticalAlignment="Center" />
        </WrapPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Border Padding="12" Background="{DynamicResource AxialThemeHeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" BorderThickness="1" CornerRadius="3">
                <StackPanel>
                    <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="17" Style="{StaticResource HealthText}" />
                    <TextBlock x:Name="StatusDetailLabel" Text="Health is observed from one connected SQL Server instance."
                               Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ProgressBar x:Name="BusyIndicator" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,4,0,0" />
            <TextBlock x:Name="ErrorLabel" Visibility="Collapsed" Foreground="{DynamicResource AxialThemeStatusErrorBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Participating availability groups" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ItemsControl x:Name="MemberCards" Grid.Row="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,10,0" Padding="12" BorderThickness="1" CornerRadius="3"
                                BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Grid.ColumnSpan="2" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="{Binding Role}" Margin="0,4,0,10" FontWeight="SemiBold" Grid.ColumnSpan="2" />
                                <TextBlock Grid.Row="2" Text="Health" Margin="0,0,15,5" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayHealth}" ToolTip="{Binding SynchronizationHealth}" Style="{StaticResource HealthText}" />
                                <TextBlock Grid.Row="3" Text="Connection" Margin="0,0,15,5" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectionState}" ToolTip="{Binding LastError}" />
                                <TextBlock Grid.Row="4" Text="Commit mode" Margin="0,0,15,5" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AvailabilityMode}" />
                                <TextBlock Grid.Row="5" Text="Endpoint" Margin="0,0,15,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EndpointUrl}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding EndpointUrl}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Database replication" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="DatabaseCountLabel" Margin="12,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Grid.Row="5">
            <DataGrid x:Name="DatabaseGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                      SelectionUnit="CellOrRowHeader" HeadersVisibility="Column" MinHeight="100">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="170" />
                    <DataGridTextColumn Header="Member AG" Binding="{Binding MemberName}" Width="160" />
                    <DataGridTemplateColumn Header="Health" Width="135" SortMemberPath="DisplayHealth">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding DisplayHealth}" ToolTip="{Binding SynchronizationHealth}" Style="{StaticResource HealthText}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Synchronization" Binding="{Binding SynchronizationState}" Width="150" />
                    <DataGridTextColumn Header="Database state" Binding="{Binding DatabaseState}" Width="135" />
                    <DataGridTextColumn Header="Suspended" Binding="{Binding IsSuspended, TargetNullValue=N/A}" Width="90" />
                    <DataGridTextColumn Header="Send queue (KB)" Binding="{Binding SendQueueKb, StringFormat=N0, TargetNullValue=N/A}" Width="125" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Send (KB/s)" Binding="{Binding SendRateKb, StringFormat=N0, TargetNullValue=N/A}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Redo queue (KB)" Binding="{Binding RedoQueueKb, StringFormat=N0, TargetNullValue=N/A}" Width="125" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Redo (KB/s)" Binding="{Binding RedoRateKb, StringFormat=N0, TargetNullValue=N/A}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Lag (seconds)" Binding="{Binding LagSeconds, StringFormat=N0, TargetNullValue=N/A}" Width="115" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Last hardened (server time)" Binding="{Binding LastHardenedTime, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=N/A}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyLabel" Text="No snapshot loaded." HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="540" Margin="20" IsHitTestVisible="False" />
        </Grid>
        <TextBlock Grid.Row="6" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                   Text="Read-only view from one instance. Remote values may be unavailable or last reported. N/A is not zero. Async replicas can be healthy while synchronizing. Health does not establish failover readiness or zero data loss." />
    </Grid>
</UserControl>
