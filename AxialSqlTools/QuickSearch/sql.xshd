<?xml version="1.0"?>
<SyntaxDefinition name="SQL" extensions=".sql"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <!-- Light-theme SSMS defaults. SqlEditorSupport adapts these for dark/high contrast themes.
       https://learn.microsoft.com/en-us/ssms/scripting/color-coding-in-query-editors -->
  <Color name="Keyword" foreground="#0000FF" fontWeight="normal" />
  <Color name="Comment" foreground="#008000" fontWeight="normal" />
  <Color name="String" foreground="#FF0000" fontWeight="normal" />
  <Color name="SystemFunction" foreground="#FF00FF" fontWeight="normal" />
  <Color name="SystemObject" foreground="#008000" fontWeight="normal" />
  <Color name="SystemProcedure" foreground="#800000" fontWeight="normal" />
  <Color name="Operator" foreground="#808080" fontWeight="normal" />
  <!-- Identifiers, local variables and numbers inherit the editor's plain text color. -->
  <Color name="Identifier" fontWeight="normal" />

  <RuleSet name="BlockComment">
    <Span color="Comment" begin="/\*" end="\*/" multiline="true" ruleSet="BlockComment" />
  </RuleSet>

  <RuleSet ignoreCase="true">
    <Span color="Comment" begin="--" />
    <Span color="Comment" begin="/\*" end="\*/" multiline="true" ruleSet="BlockComment" />
    <Span color="String" begin="(?&lt;![\w@#$])N?'" end="'" multiline="true">
      <RuleSet><Span begin="''" end="" /></RuleSet>
    </Span>
    <!-- Delimited identifiers may contain keywords, quotes, dots or comment markers. -->
    <Span color="Identifier" begin="\[" end="\]" multiline="true">
      <RuleSet><Span begin="\]\]" end="" /></RuleSet>
    </Span>
    <Span color="Identifier" begin="&quot;" end="&quot;" multiline="true">
      <RuleSet><Span begin="&quot;&quot;" end="" /></RuleSet>
    </Span>

    <Rule color="SystemFunction">@@[\w$#]+</Rule>
    <Rule color="Identifier">@[\w$#]+</Rule>
    <!-- A qualified name is a user identifier even when its last part is a built-in name. -->
    <Rule color="Identifier">(?&lt;=\.)\s*[\p{L}_#][\w$#@]*</Rule>
    <Rule color="SystemObject">\b(?:sys|INFORMATION_SCHEMA)\s*\.\s*[\p{L}_][\w$#@]*</Rule>
    <!-- Only known built-ins followed by '(' are functions; dbo.func(...) stays plain. -->
    <Rule color="SystemFunction">
      \b(?:
        ABS|ACOS|APPLOCK_MODE|APPLOCK_TEST|APP_NAME|ASCII|ASIN|ATAN|ATN2|AVG
        |BINARY_CHECKSUM|CAST|CEILING|CHARINDEX|CHECKSUM|CHECKSUM_AGG|CHOOSE|COALESCE|COLUMNPROPERTY
        |COL_LENGTH|COL_NAME|CONCAT|CONCAT_WS|CONNECTIONPROPERTY|CONTEXT_INFO|CONVERT|COS|COT|COUNT
        |COUNT_BIG|CUME_DIST|CURRENT_REQUEST_ID|CURRENT_TRANSACTION_ID|DATABASEPROPERTYEX|DATABASE_PRINCIPAL_ID|DATALENGTH|DATEADD|DATEDIFF|DATEDIFF_BIG
        |DATEFROMPARTS|DATENAME|DATEPART|DATETIME2FROMPARTS|DATETIMEFROMPARTS|DATETIMEOFFSETFROMPARTS|DATETRUNC|DAY|DB_ID|DB_NAME
        |DEGREES|DENSE_RANK|DIFFERENCE|EOMONTH|ERROR_LINE|ERROR_MESSAGE|ERROR_NUMBER|ERROR_PROCEDURE|ERROR_SEVERITY|ERROR_STATE
        |EXP|FILEGROUPPROPERTY|FILEGROUP_ID|FILEGROUP_NAME|FILEPROPERTY|FILE_ID|FILE_IDEX|FILE_NAME|FIRST_VALUE|FLOOR
        |FORMAT|FORMATMESSAGE|GETANSINULL|GETDATE|GETUTCDATE|GROUPING|GROUPING_ID|HASHBYTES|HOST_ID|HOST_NAME
        |IIF|IDENT_CURRENT|IDENT_INCR|IDENT_SEED|INDEXKEY_PROPERTY|INDEXPROPERTY|INDEX_COL|ISDATE|ISJSON|ISNULL|ISNUMERIC
        |IS_MEMBER|IS_ROLEMEMBER|IS_SRVROLEMEMBER|JSON_ARRAY|JSON_MODIFY|JSON_OBJECT|JSON_PATH_EXISTS|JSON_QUERY|JSON_VALUE|LAG
        |LAST_VALUE|LEAD|LEFT|LEN|LOG|LOG10|LOWER|LTRIM|MAX|MIN
        |MONTH|NEWID|NEWSEQUENTIALID|NTILE|NULLIF|OBJECTPROPERTY|OBJECTPROPERTYEX|OBJECT_DEFINITION|OBJECT_ID
        |OBJECT_NAME|OBJECT_SCHEMA_NAME|ORIGINAL_LOGIN|PARSENAME|PATINDEX|PERCENTILE_CONT|PERCENTILE_DISC|PERCENT_RANK|PI|POWER
        |QUOTENAME|RADIANS|RAND|RANK|REPLACE|REPLICATE|REVERSE|RIGHT|ROUND|ROW_NUMBER
        |RTRIM|SCHEMA_ID|SCHEMA_NAME|SCOPE_IDENTITY|SERVERPROPERTY|SESSIONPROPERTY|SESSION_CONTEXT|SESSION_ID|SIGN|SIN
        |SMALLDATETIMEFROMPARTS|SOUNDEX|SPACE|SQL_VARIANT_PROPERTY|SQRT|SQUARE|STATS_DATE|STDEV|STDEVP|STRING_AGG
        |STRING_ESCAPE|STUFF|SUBSTRING|SUM|SUSER_ID|SUSER_NAME|SUSER_SID|SUSER_SNAME|SWITCHOFFSET|SYSDATETIME
        |SYSDATETIMEOFFSET|SYSUTCDATETIME|TAN|TIMEFROMPARTS|TODATETIMEOFFSET|TRANSLATE|TRIM|TRY_CAST|TRY_CONVERT|TRY_PARSE
        |TYPEPROPERTY|TYPE_ID|TYPE_NAME|UNICODE|UPPER|USER_ID|USER_NAME|VAR|VARP|XACT_STATE
        |YEAR
      )\b(?=\s*\()
    </Rule>

    <Keywords color="SystemProcedure">
      <Word>sp_describe_first_result_set</Word><Word>sp_describe_undeclared_parameters</Word><Word>sp_executesql</Word><Word>sp_help</Word><Word>sp_helpdb</Word>
      <Word>sp_helpindex</Word><Word>sp_helptext</Word><Word>sp_server_info</Word><Word>sp_set_session_context</Word><Word>sp_spaceused</Word>
      <Word>sp_who</Word><Word>sp_who2</Word>
    </Keywords>

    <Keywords color="Operator">
      <Word>AND</Word><Word>ANY</Word><Word>APPLY</Word><Word>BETWEEN</Word><Word>CROSS</Word>
      <Word>EXISTS</Word><Word>FULL</Word><Word>IN</Word><Word>INNER</Word><Word>IS</Word>
      <Word>JOIN</Word><Word>LEFT</Word><Word>LIKE</Word><Word>NOT</Word><Word>OR</Word>
      <Word>OUTER</Word><Word>PIVOT</Word><Word>RIGHT</Word><Word>SOME</Word><Word>UNPIVOT</Word>
    </Keywords>

    <Keywords color="Keyword">
      <Word>ADD</Word><Word>ALL</Word><Word>ALTER</Word><Word>AS</Word><Word>ASC</Word>
      <Word>AUTHORIZATION</Word><Word>BACKUP</Word><Word>BEGIN</Word><Word>BIGINT</Word><Word>BINARY</Word>
      <Word>BIT</Word><Word>BREAK</Word><Word>BROWSE</Word><Word>BULK</Word><Word>BY</Word>
      <Word>CASCADE</Word><Word>CASE</Word><Word>CATCH</Word><Word>CHAR</Word><Word>CHECK</Word>
      <Word>CHECKPOINT</Word><Word>CLOSE</Word><Word>CLUSTERED</Word><Word>COLLATE</Word><Word>COLUMN</Word>
      <Word>COMMIT</Word><Word>COMPUTE</Word><Word>CONSTRAINT</Word><Word>CONTAINS</Word><Word>CONTAINSTABLE</Word>
      <Word>CONTINUE</Word><Word>CREATE</Word><Word>CURRENT</Word><Word>CURRENT_DATE</Word><Word>CURRENT_TIME</Word>
      <Word>CURRENT_TIMESTAMP</Word><Word>CURRENT_USER</Word><Word>CURSOR</Word><Word>DATABASE</Word><Word>DATE</Word>
      <Word>DATETIME</Word><Word>DATETIME2</Word><Word>DATETIMEOFFSET</Word><Word>DBCC</Word><Word>DEALLOCATE</Word>
      <Word>DEC</Word><Word>DECIMAL</Word><Word>DECLARE</Word><Word>DEFAULT</Word><Word>DELETE</Word>
      <Word>DENY</Word><Word>DESC</Word><Word>DISABLE</Word><Word>DISTINCT</Word><Word>DISTRIBUTED</Word>
      <Word>DOUBLE</Word><Word>DROP</Word><Word>DUMP</Word><Word>ELSE</Word><Word>ENABLE</Word>
      <Word>END</Word><Word>ERRLVL</Word><Word>ESCAPE</Word><Word>EXCEPT</Word><Word>EXEC</Word>
      <Word>EXECUTE</Word><Word>EXIT</Word><Word>EXTERNAL</Word><Word>FETCH</Word><Word>FILE</Word>
      <Word>FILLFACTOR</Word><Word>FLOAT</Word><Word>FOR</Word><Word>FOREIGN</Word><Word>FREETEXT</Word>
      <Word>FREETEXTTABLE</Word><Word>FROM</Word><Word>FUNCTION</Word><Word>GO</Word><Word>GOTO</Word>
      <Word>GRANT</Word><Word>GROUP</Word><Word>HAVING</Word><Word>HOLDLOCK</Word><Word>IDENTITY</Word>
      <Word>IDENTITY_INSERT</Word><Word>IF</Word><Word>IMAGE</Word><Word>INDEX</Word><Word>INSERT</Word>
      <Word>INT</Word><Word>INTEGER</Word><Word>INTERSECT</Word><Word>INTO</Word><Word>KEY</Word>
      <Word>KILL</Word><Word>LINENO</Word><Word>LOAD</Word><Word>MERGE</Word><Word>MONEY</Word>
      <Word>NATIONAL</Word><Word>NCHAR</Word><Word>NEXT</Word><Word>NOCHECK</Word><Word>NOCOUNT</Word>
      <Word>NOLOCK</Word><Word>NONCLUSTERED</Word><Word>NULL</Word><Word>NUMERIC</Word><Word>NVARCHAR</Word>
      <Word>OF</Word><Word>OFF</Word><Word>OFFSET</Word><Word>OFFSETS</Word><Word>ON</Word><Word>ONLY</Word>
      <Word>OPEN</Word><Word>OPENDATASOURCE</Word><Word>OPENQUERY</Word><Word>OPENROWSET</Word><Word>OPENXML</Word>
      <Word>OPTION</Word><Word>ORDER</Word><Word>OUTPUT</Word><Word>OVER</Word><Word>PARTITION</Word>
      <Word>PERCENT</Word><Word>PLAN</Word><Word>PRECISION</Word><Word>PRIMARY</Word><Word>PRINT</Word>
      <Word>PROC</Word><Word>PROCEDURE</Word><Word>PUBLIC</Word><Word>RAISERROR</Word><Word>READ</Word>
      <Word>READCOMMITTED</Word><Word>READPAST</Word><Word>READTEXT</Word><Word>READUNCOMMITTED</Word><Word>REAL</Word>
      <Word>RECOMPILE</Word><Word>REFERENCES</Word><Word>REPLICATION</Word><Word>RESTORE</Word><Word>RESTRICT</Word>
      <Word>RETURN</Word><Word>RETURNS</Word><Word>REVERT</Word><Word>REVOKE</Word><Word>ROLLBACK</Word>
      <Word>ROW</Word><Word>ROWCOUNT</Word><Word>ROWGUIDCOL</Word><Word>ROWS</Word><Word>ROWVERSION</Word>
      <Word>RULE</Word><Word>SAVE</Word><Word>SCHEMA</Word><Word>SECURITYAUDIT</Word><Word>SELECT</Word>
      <Word>SEMANTICKEYPHRASETABLE</Word><Word>SEMANTICSIMILARITYDETAILSTABLE</Word><Word>SEMANTICSIMILARITYTABLE</Word><Word>SEQUENCE</Word><Word>SERIALIZABLE</Word>
      <Word>SESSION_USER</Word><Word>SET</Word><Word>SETUSER</Word><Word>SHUTDOWN</Word><Word>SMALLDATETIME</Word>
      <Word>SMALLINT</Word><Word>SMALLMONEY</Word><Word>SNAPSHOT</Word><Word>SQL_VARIANT</Word><Word>STATISTICS</Word>
      <Word>SYSNAME</Word><Word>SYSTEM_USER</Word><Word>TABLE</Word><Word>TABLESAMPLE</Word><Word>TEXT</Word>
      <Word>TEXTSIZE</Word><Word>THEN</Word><Word>THROW</Word><Word>TIME</Word><Word>TIMESTAMP</Word>
      <Word>TINYINT</Word><Word>TO</Word><Word>TOP</Word><Word>TRAN</Word><Word>TRANSACTION</Word>
      <Word>TRIGGER</Word><Word>TRUNCATE</Word><Word>TRY</Word><Word>TSEQUAL</Word><Word>TYPE</Word>
      <Word>UNION</Word><Word>UNIQUE</Word><Word>UNIQUEIDENTIFIER</Word><Word>UPDATE</Word><Word>UPDATETEXT</Word><Word>USE</Word>
      <Word>USER</Word><Word>VALUES</Word><Word>VARBINARY</Word><Word>VARCHAR</Word><Word>VARYING</Word>
      <Word>VIEW</Word><Word>WAITFOR</Word><Word>WHEN</Word><Word>WHERE</Word><Word>WHILE</Word>
      <Word>WITH</Word><Word>WITHIN</Word><Word>WRITETEXT</Word><Word>XML</Word>
    </Keywords>

    <Rule color="Identifier">
      \b0[xX][0-9a-fA-F]+
      | (?:\b[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?
    </Rule>
    <Rule color="Operator">[.,;(){}+\-/%*&lt;&gt;=^~!|&amp;?:]+</Rule>
    <!-- Consume the entire name, including #temp names and Unicode identifiers. -->
    <Rule color="Identifier">[\p{L}_#][\w$#@]*</Rule>
  </RuleSet>
</SyntaxDefinition>
